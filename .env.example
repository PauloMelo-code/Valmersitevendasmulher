# Endereço final da página, sem barra no fim (usado no sitemap, llms.txt, canonical e og:image)
SITE_URL=https://lideranca.seudominio.com.br
# Conexão com o Postgres (no Easypanel: copiar a "Internal Connection URL" do serviço Postgres)
DATABASE_URL=postgres://dev:dev@localhost:5441/pagina_vendas_dev
# ID do Pixel da Meta (só números). Vazio = pixel desligado
META_PIXEL_ID=
# Link do checkout já com o cupom INTELIGENTE. Vazio = botões rolam até a oferta
CHECKOUT_URL=
# Acesso ao /painel. Senha com 12+ caracteres, senão o painel fica desligado
PAINEL_USUARIO=admin
PAINEL_SENHA=
